# Copy to .env and fill in your own configuration. Never commit .env.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_HOST=example.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/knowledge-base
SHAREPOINT_DRIVE_NAME=Documents
SHAREPOINT_ROOT_FOLDER=knowledge-base/tickets
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_EMAIL=agent@example.com
ZENDESK_API_TOKEN=
ZENDESK_START_TIME=2026-01-01T00:00:00Z
SYNC_MODE=incremental
SYNC_STATE_BACKEND=file
SYNC_STATE_PATH=state/sync_state.json
# For Azure Functions, use SYNC_STATE_BACKEND=blob and set these values:
# AzureWebJobsStorage=
# SYNC_STATE_CONTAINER=sync-state
# SYNC_STATE_BLOB_NAME=zendesk/sync_state.json
